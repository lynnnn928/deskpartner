{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.lynnnn928/deskpartner",
  "description": "A shared local kanban board for your AI agents (69 MCP tools, 15 guardrails, 100% local SQLite).",
  "repository": {
    "url": "https://github.com/lynnnn928/deskpartner",
    "source": "github"
  },
  "version_detail": {
    "version": "1.0.134"
  },
  "packages": [
    {
      "registry_name": "github",
      "name": "lynnnn928/deskpartner",
      "version": "1.0.134",
      "runtime": "node",
      "transport": {
        "type": "stdio"
      },
      "environment_variables": [
        {
          "name": "DESKPARTNER_AGENT",
          "description": "Agent identity (e.g., agent:claude, agent:cursor)",
          "is_required": true
        }
      ]
    }
  ]
}
