{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.lynnnn928/deskpartner",
  "description": "A shared local kanban board for your AI agents (69 MCP tools, 15 guardrails, 100% local SQLite).",
  "version": "1.0.143",
  "repository": {
