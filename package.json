{
  "name": "desk-partner",
  "version": "1.0.136",
  "description": "桌面悬浮待办助手",
  "main": "./out/main/index.js",
  "author": "LiLin (https://github.com/lynnnn928)",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build && npm run build:cli",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/swap-abi.mjs electron",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "rebuild:node": "node scripts/swap-abi.mjs node",
    "rebuild:electron": "node scripts/swap-abi.mjs electron",
    "format": "prettier --write .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "verify": "node scripts/verify-all.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "verify:gates": "node scripts/verify-gates-reverse.cjs",
    "release": "node scripts/release.mjs",
    "test:only": "vitest run",
    "build:cli": "node scripts/build-cli.mjs",
    "verify:backup": "node scripts/verify-backup-roundtrip.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:facts": "node scripts/verify-current-facts.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "better-sqlite3": "^11.6.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "uuid": "^10.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "sql.js": "^1.14.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.deskpartner.app",
    "productName": "DeskPartner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/cli/**",
      "resources/**/*",
      "COLLABORATION.md",
      "ISSUE_STYLE.md",
      "TESTING.md",
      "docs/DESIGN.md",
      "CHANGELOG.md",
      "docs/architecture/2026-10-28-gui-page-capability-map.md",
      "docs/generated/headless-surface.md"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "out/cli",
        "to": "cli"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeskPartner"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "npmRebuild": true,
    "publish": [
      {
        "provider": "github",
        "owner": "lynnnn928",
        "repo": "deskpartner"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynnnn928/deskpartner.git"
  },
  "homepage": "https://lynnnn928.github.io/deskpartner/"
}
