{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "outDir": "./out/main",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@main/*": ["src/main/*"],
      "@shared/*": ["src/renderer/types/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/types/**/*",
    "src/renderer/lib/constants.ts",
    "src/cli/pipe-protocol.ts",
    "src/cli/credentials.ts",
    "src/cli/file-flags.ts",
    "src/cli/mcp-server.ts",
    "src/cli/mcp-tools-from-schema.ts",
    "src/cli/mcp-main.ts",
    "electron.vite.config.ts"
  ]
}
